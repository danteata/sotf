# Convex
VITE_CONVEX_URL=

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=

# UploadThing
VITE_UPLOADTHING_TOKEN=

# Analytics — pick a provider
#   posthog | amplitude | console | none
# Default: 'console' (logs to browser devtools)
VITE_ANALYTICS_PROVIDER=console
VITE_ANALYTICS_ENABLED=true

# PostHog — set when VITE_ANALYTICS_PROVIDER=posthog
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Amplitude — set when VITE_ANALYTICS_PROVIDER=amplitude
VITE_AMPLITUDE_KEY=
VITE_AMPLITUDE_SESSION_REPLAY_SAMPLE_RATE=1

# Optional app version attached to every event
VITE_APP_VERSION=0.1.0
